#include <iostream>
#include <string>

using namespace std;

// Maximum number of students the system can hold
const int MAX_STUDENTS = 100;

// Structure to hold student details
struct Student {
    int rollNo;
    string name;
    float marks;
};

// Global array and counter to track active records
Student students[MAX_STUDENTS];
int studentCount = 0;

// Function to add a student record
void addStudent() {
    if (studentCount >= MAX_STUDENTS) {
        cout << "\nError: Student database is full!\n";
        return;
    }

    Student newStudent;
    cout << "\nEnter Roll Number: ";
    cin >> newStudent.rollNo;

    // Check for duplicate roll numbers
    for (int i = 0; i < studentCount; i++) {
        if (students[i].rollNo == newStudent.rollNo) {
            cout << "Error: A student with Roll Number " << newStudent.rollNo << " already exists.\n";
            return;
        }
    }

    cout << "Enter Name: ";
    cin.ignore(); // Clear buffer before reading string
    getline(cin, newStudent.name);

    cout << "Enter Marks: ";
    cin >> newStudent.marks;

    // Save to the array
    students[studentCount] = newStudent;
    studentCount++;

    cout << "Student record added successfully!\n";
}

// Function to display all student records
void displayAllStudents() {
    if (studentCount == 0) {
        cout << "\nNo student records found in the system.\n";
        return;
    }

    cout << "\n--- All Student Records ---\n";
    cout << "---------------------------------------------\n";
    cout << "Roll No\t\tName\t\t\tMarks\n";
    cout << "---------------------------------------------\n";
    for (int i = 0; i < studentCount; i++) {
        cout << students[i].rollNo << "\t\t" 
             << students[i].name << "\t\t\t" 
             << students[i].marks << "\n";
    }
    cout << "---------------------------------------------\n";
}

// Function to search for a student by roll number
void searchStudent() {
    if (studentCount == 0) {
        cout << "\nNo student records found to search from.\n";
        return;
    }

    int searchRoll;
    cout << "\nEnter Roll Number to search: ";
    cin >> searchRoll;

    for (int i = 0; i < studentCount; i++) {
        if (students[i].rollNo == searchRoll) {
            cout << "\nRecord Found!\n";
            cout << "-------------------------\n";
            cout << "Roll Number : " << students[i].rollNo << "\n";
            cout << "Name        : " << students[i].name << "\n";
            cout << "Marks       : " << students[i].marks << "\n";
            cout << "-------------------------\n";
            return;
        }
    }

    cout << "Student with Roll Number " << searchRoll << " not found.\n";
}

// Main operational driver code
int main() {
    int choice;

    do {
        cout << "\n=== Student Management System ===\n";
        cout << "1. Add Student Record\n";
        cout << "2. Display All Student Records\n";
        cout << "3. Search Student by Roll Number\n";
        cout << "4. Exit\n";
        cout << "Enter your choice (1-4): ";
        cin >> choice;

        switch (choice) {
            case 1:
                addStudent();
                break;
            case 2:
                displayAllStudents();
                break;
            case 3:
                searchStudent();
                break;
            case 4:
                cout << "\nExiting program. Goodbye!\n";
                break;
            default:
                cout << "\nInvalid choice! Please enter a number between 1 and 4.\n";
        }
    } while (choice != 4);

    return 0;
}
