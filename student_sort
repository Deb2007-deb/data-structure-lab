#include <iostream>

using namespace std;

int main() {
    int marks[5];
    int i, j, temp;

    
    cout << "Enter the marks of 5 students:\n";
    for (i = 0; i < 5; i++) {
        cout << "Student " << i + 1 << ": ";
        cin >> marks[i];
    }

    
    for (i = 0; i < 5 - 1; i++) {
        for (j = 0; j < 5 - i - 1; j++) {
            if (marks[j] < marks[j + 1]) {
             
                temp = marks[j];
                marks[j] = marks[j + 1];
                marks[j + 1] = temp;
            }
        }
    }

    
    cout << "\nMarks in descending order (Highest to Lowest):\n";
    for (i = 0; i < 5; i++) {
        cout << "Student " << i + 1 << ": " << marks[i] << endl;
    }

    return 0;
}
